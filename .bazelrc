# bzlmod is the source of truth; no WORKSPACE.
common --enable_bzlmod
common --registry=https://bcr.bazel.build

# Some Bazel/JDK combos emit SVE instructions that SIGILL on certain aarch64
# hosts. UseSVE only EXISTS on aarch64 JVMs — an unrecognized -XX option is
# fatal at JVM startup (found the hard way on x86_64 CI) — so it must ride
# behind IgnoreUnrecognizedVMOptions, in this order.
startup --host_jvm_args=-XX:+IgnoreUnrecognizedVMOptions
startup --host_jvm_args=-XX:UseSVE=0

# rules_python 2.x requires the script bootstrap under Bazel 8.
common --@rules_python//python/config_settings:bootstrap_impl=script

# Hermetic action env so the on-disk cache is correct across machines.
build --incompatible_strict_action_env

# Persist caches in the project tree (gitignored) so they survive container
# restarts that wipe ~/.cache. Content-addressable, safe on any filesystem.
# These per-tree paths are the fallback: the tools/bazel Bazelisk wrapper
# overrides them (via a generated --bazelrc) with a cache shared across all
# worktrees of the repo, so a fresh worktree starts warm. See README.
build  --disk_cache=.bazel-disk-cache
common --repository_cache=.bazel-repo-cache

test --test_output=errors
