# systemd user unit for the issuefleet daemon.
#   cp deploy/issuefleet.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now issuefleet
# Adjust ExecStart/paths. The daemon exits cleanly on SIGTERM (finishes its
# tick); workers keep running in their tmux sessions either way.

[Unit]
Description=issuefleet: Linear -> GitHub work-queue orchestrator
After=network-online.target

[Service]
Type=simple
ExecStart=%h/Projects/issuefleet/bin/issuefleet run
Restart=on-failure
RestartSec=30
# tmux, docker, claude-container, git must be reachable:
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin
StandardOutput=append:%h/.local/state/issuefleet/daemon.log
StandardError=append:%h/.local/state/issuefleet/daemon.log

[Install]
WantedBy=default.target
