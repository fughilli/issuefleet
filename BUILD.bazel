load("@rules_uv//uv:pip.bzl", "pip_compile")

package(default_visibility = ["//visibility:public"])

exports_files([
    "flake.nix",
    "AGENT_BUILD_PROMPT.md",
])

# `bazel run //:issuefleet -- doctor` etc. The bin/issuefleet shell wrapper
# is the zero-install equivalent for hosts without Bazel.
alias(
    name = "issuefleet",
    actual = "//src/issuefleet:cli",
)

# `bazel run //:requirements` rewrites requirements_lock.txt from
# requirements.in; `bazel test //:requirements_test` (generated by this macro)
# fails when the two have drifted, so a hand-edited lock can't go unnoticed.
# Hashes come from uv's default --generate-hashes.
pip_compile(
    name = "requirements",
    requirements_in = "//:requirements.in",
    requirements_txt = "//:requirements_lock.txt",
)
