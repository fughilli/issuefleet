load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "fakes",
    srcs = ["fakes.py"],
    imports = ["."],
    deps = ["//src/issuefleet"],
)

[
    py_test(
        name = f[:-len(".py")],
        srcs = [f],
        deps = [
            ":fakes",
            "//src/issuefleet",
        ],
    )
    for f in glob(["test_*.py"], exclude = ["test_bazel_wrapper.py"])
]

# Exercises the real tools/bazel script, so it needs the file as a runfile.
py_test(
    name = "test_bazel_wrapper",
    srcs = ["test_bazel_wrapper.py"],
    data = ["//tools:bazel"],
    deps = [
        ":fakes",
        "//src/issuefleet",
    ],
)
